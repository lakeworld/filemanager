{
  "name": "qihe-box",
  "productName": "启禾文件管理",
  "version": "2.5.7",
  "description": "启禾文件管理（BOX 项目）—— Electron 重构版：电商产品图包与证书管理",
  "homepage": "https://www.qihebook.cloud/file-manager",
  "desktopName": "qihe-box",
  "main": "./out/main/index.js",
  "author": "启禾软件 <ai_qihe@vip.qq.com>",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "api:update": "node scripts/update-api-surface.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/build-hello-plugin.mjs",
    "conformance": "node tests/e2e/conformance/run-conformance.mjs",
    "preconformance": "node scripts/build-hello-plugin.mjs",
    "test:memory-soak": "playwright test --config=playwright.memory-soak.config.ts",
    "pretest:memory-soak": "node scripts/build-hello-plugin.mjs && node scripts/build-conformance-fixtures.mjs",
    "test:memory-baseline": "npm run test:memory-soak",
    "summarize:memory": "node scripts/summarize-memory-runs.mjs memory-soak-results/memory-soak-*.json",
    "bench": "vitest run tests/bench",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "build:win": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.1",
    "@tanstack/solid-virtual": "^3.13.36",
    "exceljs": "^4.4.0",
    "marked": "18.0.9",
    "pdfjs-dist": "^4.8.69",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@solidjs/router": "^1.0.0",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.5.4",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "fast-check": "^3.23.2",
    "postcss": "^8.5.26",
    "solid-js": "^1.9.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
